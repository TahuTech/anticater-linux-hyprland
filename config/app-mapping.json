{
  "global": {
    "rotate_left": {
      "type": "key",
      "description": "Kecilkan volume",
      "keys": [
        "volume_down"
      ]
    },
    "rotate_right": {
      "type": "key",
      "description": "Besarkan volume",
      "keys": [
        "volume_up"
      ]
    },
    "press": {
      "type": "key",
      "description": "Play / pause",
      "keys": [
        "play_pause"
      ]
    },
    "press_rotate_left": {
      "type": "key",
      "description": "Lagu sebelumnya",
      "keys": [
        "previous_track"
      ]
    },
    "press_rotate_right": {
      "type": "key",
      "description": "Lagu berikutnya",
      "keys": [
        "next_track"
      ]
    }
  },
  "apps": {
    "brave-browser": {
      "rotate_left": {
        "type": "shortcut",
        "description": "Tab sebelumnya",
        "keys": [
          "control",
          "shift",
          "tab"
        ]
      },
      "rotate_right": {
        "type": "shortcut",
        "description": "Tab berikutnya",
        "keys": [
          "control",
          "tab"
        ]
      },
      "press": {
        "type": "shortcut",
        "description": "Muat ulang halaman",
        "keys": [
          "control",
          "r"
        ]
      },
      "press_rotate_left": {
        "type": "shortcut",
        "description": "Kembali (riwayat)",
        "keys": [
          "control",
          "left"
        ]
      },
      "press_rotate_right": {
        "type": "key",
        "description": "Maju (riwayat)",
        "keys": [
          "a"
        ]
      }
    },
    "code": {
      "rotate_left": {
        "type": "shortcut",
        "description": "Editor sebelumnya",
        "keys": [
          "control",
          "pageup"
        ]
      },
      "rotate_right": {
        "type": "shortcut",
        "description": "Editor berikutnya",
        "keys": [
          "control",
          "pagedown"
        ]
      },
      "press": {
        "type": "shortcut",
        "description": "Palet perintah",
        "keys": [
          "control",
          "shift",
          "p"
        ]
      },
      "press_rotate_left": {
        "type": "shortcut",
        "description": "Masalah sebelumnya",
        "keys": [
          "f8"
        ]
      },
      "press_rotate_right": {
        "type": "shortcut",
        "description": "Masalah berikutnya",
        "keys": [
          "shift",
          "f8"
        ]
      }
    },
    "Spotify": {
      "rotate_left": {
        "type": "key",
        "description": "Gulir ke atas (PageUp)",
        "keys": [
          "pageup"
        ]
      },
      "rotate_right": {
        "type": "key",
        "description": "Gulir ke bawah (PageDown)",
        "keys": [
          "pagedown"
        ]
      },
      "press": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "press_rotate_left": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "press_rotate_right": {
        "type": "noop",
        "keys": [],
        "description": ""
      }
    },
    "kitty": {
      "rotate_left": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "rotate_right": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "press": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "press_rotate_left": {
        "type": "noop",
        "keys": [],
        "description": ""
      },
      "press_rotate_right": {
        "type": "key",
        "keys": [
          "1"
