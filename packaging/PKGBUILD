# Maintainer: TahuTech <tahutech@users.noreply.github.com>
_pkgname=anticater-linux-hyprland
pkgname=$_pkgname-git
pkgver=r0.gc021cc1
pkgrel=1
pkgdesc="Daemon kontrol knob ANTICATER VK-01 untuk Hyprland: gestur knob -> aksi per-aplikasi (evdev grab + uinput/hyprctl), GUI editor config, probe HID"
arch=('any')
url="https://github.com/TahuTech/anticater-linux-hyprland"
license=('MIT')
depends=('python' 'python-evdev')
makedepends=('git')
source=("$_pkgname::git+https://github.com/TahuTech/anticater-linux-hyprland.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "%s" "$(git describe --long --tags --always | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')"
}

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 daemon/anticaterd.py      "$pkgdir/usr/bin/anticaterd"
  install -Dm755 gui/anticater-gui.py      "$pkgdir/usr/bin/anticater-gui"
  install -Dm755 probes/probe_evdev.py     "$pkgdir/usr/bin/anticater-probe-evdev"
  install -Dm755 probes/probe_hidraw.py    "$pkgdir/usr/bin/anticater-probe-hidraw"
  install -Dm644 rules/60-anticater.rules  "$pkgdir/usr/lib/udev/rules.d/60-anticater.rules"
  install -Dm644 config/app-mapping.json   "$pkgdir/etc/anticater/app-mapping.json"
  install -Dm644 LICENSE                   "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md                 "$pkgdir/usr/share/doc/$pkgname/README.md"
}